# Prod/stage окружение — используется compose.stage.yml и compose.vm*.yml.
# Скопируй в .env и заполни секреты:  cp .env.prod.example .env

# ===== Общие =====
COMPOSE_PROJECT_NAME=muzilla
APP_ENV=production
APP_DEBUG=false

# Любой непустой токен — внутренний для mz-discogs сервиса
DISCOGS_API_TOKEN=placeholder

# ===== PostgreSQL =====
POSTGRES_USER=muzilla
# openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=muzilla_main
# Для prod (без VLAN) — обязательно SSL: require/verify-ca/verify-full
DB_SSLMODE=require

# ===== Main (Laravel) =====
# echo "MAIN_APP_KEY=base64:$(openssl rand -base64 32)"
MAIN_APP_KEY=
MAIN_APP_URL=https://mzt.nadev.ru
MAIN_DB_DATABASE=muzilla_main
MAIN_DISCOGS_DB_DATABASE=muzilla_discogs

# ===== Discogs (Laravel) =====
# echo "DISCOGS_APP_KEY=base64:$(openssl rand -base64 32)"
DISCOGS_APP_KEY=
DISCOGS_APP_URL=https://mzt.nadev.ru
DISCOGS_DB_DATABASE=muzilla_discogs

# ===== Redis (на VM-2 в prod) =====
REDIS_HOST=redis
REDIS_PORT=6379
# Обязательно для prod (публичная сеть). openssl rand -hex 32
REDIS_PASSWORD=

# ===== Meilisearch =====
# openssl rand -hex 32
MEILI_MASTER_KEY=
MEILI_ENV=production

# ===== Reverb (WebSocket для Laravel broadcasting) =====
REVERB_APP_ID=muzilla
# openssl rand -base64 20
REVERB_APP_KEY=
# openssl rand -hex 32
REVERB_APP_SECRET=
REVERB_HOST=mzt.nadev.ru
REVERB_PORT=443
REVERB_SCHEME=https

# ===== Nuxt (build-args + runtime) =====
# Внутри одной docker-сети сервисы видят друг друга по имени контейнера:
NUXT_LARAVEL_URL=http://main-web
# Публичный URL для fetch'ей с клиента:
NUXT_BACKEND_BASE_URL=https://mzt.nadev.ru
NUXT_DISCOGS_BASE_URL=http://discogs-web
# ОБЯЗАТЕЛЬНО — иначе SSR падает при первом рендере главной.
NUXT_PUBLIC_YMAPS_API_KEY=00000000-0000-0000-0000-000000000000

# ===== Sanctum / Sessions (для Laravel cookie auth через https) =====
# Перечисли все public-домены через запятую (без https://, без www если не нужно).
SANCTUM_STATEFUL_DOMAINS=mzt.nadev.ru
SESSION_DOMAIN=mzt.nadev.ru
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

# ===== Image tags (для пиннинга версий) =====
MAIN_TAG=latest
DISCOGS_TAG=latest
NUXT_TAG=latest

# ===== Edge nginx ports =====
# Если на хосте Caddy — оставь loopback (127.0.0.1:8080).
# Если nginx нет на хосте — поставь 80/443 чтобы edge сам слушал внешку.
EDGE_HTTP_PORT=127.0.0.1:8080
EDGE_HTTPS_PORT=127.0.0.1:8443

# ===== Prod (3 VM) =====
# Без VLAN — публичные IP. С VLAN — приватные, плюс задай *_BIND чтобы
# контейнеры слушали только на private интерфейсе.
VM2_HOST=85.193.81.19
VM3_HOST=92.255.105.112
PUBLIC_HOST=mzt.nadev.ru
# При наличии VLAN: VM2_BIND=10.0.0.2 / VM3_BIND=10.0.0.3 (где postgres/redis слушают)
# Без VLAN — оставь незадано (default 0.0.0.0 + UFW whitelist).
# VM2_BIND=
# VM3_BIND=

# ===== MinIO (VM-3) =====
MINIO_ROOT_USER=muzilla
# openssl rand -hex 32
MINIO_ROOT_PASSWORD=

# ===== S3 Media Storage (Timeweb Cloud) =====
# Используется main и discogs для всех изображений (Discogs дискография, новости, продукты).
# Ключи получить в панели Timeweb Cloud → Object Storage → бакет muzilla-images.
S3_MEDIA_KEY=
S3_MEDIA_SECRET=
S3_MEDIA_REGION=ru-1
S3_MEDIA_BUCKET=muzilla-images
S3_MEDIA_ENDPOINT=https://s3.twcstorage.ru
S3_MEDIA_URL=https://s3.twcstorage.ru/muzilla-images
S3_MEDIA_PATH_STYLE=true

# ===== Image Processing =====
# Для prod IMAGE_DISK=s3-media — все обложки/портреты пишутся в S3.
# Для локальной разработки можно оставить public.
IMAGE_DRIVER=gd
IMAGE_WEBP_QUALITY=85
IMAGE_DISK=s3-media

# ===== Платежи: касса ПА ООО «ПЭЙ ЭНИ ВЭЙ» (54-ФЗ) =====
# Драйвер приёма НОВЫХ заказов:
#   moneta — историческая схема (assistant.htm + SOAP), чеков нет;
#   bpa    — платёжный агрегатор: JSON API с номенклатурой, чек 54-ФЗ пробивает
#            ККТ агрегатора, расщепление на счета продавцов делает он же.
# Переключение НЕ трогает уже созданные заказы: драйвер каждого записан в
# order_payments.provider и оттуда резолвится до конца жизни заказа.
#
# ⚠️ ПЕРЕД включением bpa обязательно:
#   1) применить миграции (php artisan migrate) — иначе падает создание заказа;
#   2) убедиться, что у продавцов заполнены счёт в НКО, ИНН, название и телефон
#      (php artisan sellers:fiscal-readiness --unready) — без них чекаут по их
#      товарам блокируется гейтом;
#   3) заполнить PAYMENTS_PLATFORM_* — при пустых значениях сборка чека падает.
PAYMENTS_DRIVER=moneta

# Ключ и секрет партнёра — выдаёт сервис БПА ПА (bpa.payanyway.ru) после
# заключения договора. Секретом подписываются все запросы.
BPA_KEY=
BPA_SECRET=
# Счёт ПА в системе МОНЕТА, на который принимаются деньги покупателя.
# BPA_DEBIT_ACCOUNT необязателен: при пустом значении в подпись идёт ПУСТАЯ
# СТРОКА, а не пропуск поля.
BPA_CREDIT_ACCOUNT=
BPA_DEBIT_ACCOUNT=
# Эмулятор для сред без боевых кредов. На проде всегда false.
BPA_USE_STUB=false
# Время жизни платёжной ссылки СБП, минуты. Передача QRTTL сама по себе
# означает «принимать через СБП» — отсюда способ оплаты известен заранее и
# ставка ставится фактическая (карта 5,4% / СБП 2,2%).
BPA_QR_TTL=30

# Уведомления агрегатора ПОДПИСИ НЕ ИМЕЮТ. Эшелоны защиты:
# 1) ГЛАВНЫЙ: состояние денег берём из /api/getoperation и сверяем статус
#    операции с видом уведомления, а не верим телу запроса. Выключать
#    только на время работы с эмулятором;
BPA_WEBHOOK_VERIFY_VIA_API=true
# 2) необязательный секрет в пути роута /api/webhook/bpa/{secret}. Пусто —
#    работает адрес без секрета (именно такой передан агрегатору);
#    выключить ОБА эшелона сразу нельзя: эндпоинт закроется 503-м;
BPA_WEBHOOK_SECRET=
# 3) IP-адреса агрегатора через запятую (запросить у mp@payanyway.ru).
#    ⚠️ За двойным прокси $request->ip() отдаёт адрес docker-сети, а не
#    клиента — прежде чем заполнять, проверьте, что видит Laravel.
BPA_WEBHOOK_ALLOWED_IPS=

# Роллаут по allowlist вместо глобального рубильника: ID через запятую.
# Пустые списки + PAYMENTS_DRIVER=bpa = включено для всех.
BPA_ALLOWLIST_BUYER_IDS=
BPA_ALLOWLIST_SELLER_IDS=

# === НКО МОНЕТА: регистрация продавцов ЮЛ/ИП (MerchantAPI) ===
# Боевые кабинеты (docs/business/Описание структуры ЛК ООО М9.docx):
#   ЛК1 «ООО М9 ЛК Счета»   unitId=22937867, логин moneta1@muzilla.ru
#     транзитный 30415610, комиссионный 61749923, обеспечение 80298482
#   ЛК2 «ООО М9 ЛК Клиенты» unitId=22938995, логин moneta2@muzilla.ru
#     зарегистрированные 22938996, активные 22938997,
#     без заявления 22938998, счёт-прототип 70708878
# Пароли — те, на которые сменили выданные НКО (в докe исходные 123456789/12345).
MONETA_API_URL=https://www.moneta.ru
# ЛК2 — под ним идут CreateProfile/EditProfile анкеты продавца.
MONETA_USERNAME=moneta2@muzilla.ru
MONETA_PASSWORD=
MONETA_UNIT_ROOT=22938995
MONETA_UNIT_REGISTERED=22938996
MONETA_UNIT_ACTIVE=22938997
MONETA_UNIT_WITHOUT_AGREEMENT=22938998
MONETA_ACCOUNT_PROTOTYPE=70708878
# Мастер-платёжный пароль счёта-прототипа (нужен CreateAccount/EditAccount).
MONETA_MERCHANT_PAYMENT_PASSWORD=
# Коллбеки НКО: смена статуса договора, создание счетов. Без секрета
# («код проверки целостности данных» ЛК2) эндпоинт закрыт 503-м.
MONETA_MERCHANT_WEBHOOK_URL=https://new.muzilla.ru/api/webhook/moneta/merchant
MONETA_MERCHANT_WEBHOOK_SECRET=
MONETA_WEBHOOK_ALLOWED_IPS=
# ЛК1 — счета площадки. Нужен, пока часть заказов доживает на историческом
# драйвере moneta (order_payments.provider).
MONETA_MERCHANT_ID=22937867
MONETA_API_LOGIN=moneta1@muzilla.ru
MONETA_API_KEY=
MONETA_SECRET_KEY=
MONETA_ACCOUNT_ID=30415610
MONETA_TRANSIT_ACCOUNT=30415610
MONETA_COMMISSION_ACCOUNT=61749923
MONETA_SECURITY_ACCOUNT=80298482
MONETA_PAYMENT_PASSWORD=
MONETA_TEST_MODE=false
MONETA_USE_STUB=false
MONETA_WEBHOOK_URL=https://new.muzilla.ru/api/webhook/moneta
MONETA_SUCCESS_URL=https://new.muzilla.ru/payment/success
MONETA_FAIL_URL=https://new.muzilla.ru/payment/fail
# Имена атрибутов профиля НКО для системы налогообложения и ставки НДС.
# Пусто = не отправлять: справочник атрибутов НКО не опубликован, а
# EditProfile с нераспознанным ключом отбивает ВЕСЬ запрос.
MONETA_ATTR_TAX_REGIME=
MONETA_ATTR_VAT_CODE=

# === Гейт каталога ===
# Товары продавца видны только после одобрения его анкеты НКО (договор ACTIVE
# + созданный счёт получателя). false — аварийный откат: в каталог вернутся и
# те, кому платёж провести некуда. После смены значения обязательно
# `php artisan sellers:init-verification` + переиндексация каталога.
MZ_REQUIRE_MONETA_APPROVAL=true

# Реквизиты площадки для строки доставки в чеке: у доставки нет продавца —
# договор с перевозчиком заключён площадкой, она же получает деньги за услугу.
# Название БЕЗ кавычек (агрегатор их запрещает в номенклатуре).
PAYMENTS_PLATFORM_ACCOUNT=
PAYMENTS_PLATFORM_INN=
PAYMENTS_PLATFORM_NAME="OOO M9"
PAYMENTS_PLATFORM_PHONE=
