#!/bin/bash

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🎵 Проверка кода MUZILLA...${NC}"

# Функция для отображения ошибок
display_error() {
    echo -e "${RED}❌ $1${NC}"
    exit 1
}

# Получение staged файлов
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=d | grep "\.php$" | tr '\n' ' ')
STAGED_JS_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E "\.(js|ts|vue)$" | tr '\n' ' ')

# Проверка Laravel проектов (main/ и discogs/)
if [ -n "$STAGED_PHP_FILES" ]; then
    echo -e "${YELLOW}📝 Найдено изменённых PHP файлов: $(echo $STAGED_PHP_FILES | wc -w)${NC}"

    # Проверка синтаксиса PHP
    echo "🔍 Проверка синтаксиса PHP..."
    for FILE in $STAGED_PHP_FILES; do
        if [ -f "$FILE" ]; then
            php -l "$FILE" > /dev/null 2>&1 || display_error "Синтаксическая ошибка в $FILE"
        fi
    done
    echo -e "${GREEN}✓ Синтаксис PHP корректен${NC}"

    # Laravel Pint для main/
    if [ -f "main/vendor/bin/pint" ]; then
        echo "🎨 Проверка стиля кода main/ (Laravel Pint)..."
        MAIN_FILES=$(echo $STAGED_PHP_FILES | tr ' ' '\n' | grep "^main/" | tr '\n' ' ')
        if [ -n "$MAIN_FILES" ]; then
            cd main && ./vendor/bin/pint $MAIN_FILES --test || display_error "Laravel Pint нашёл проблемы в main/. Запустите: cd main && composer fix"
            cd ..
        fi
        echo -e "${GREEN}✓ Код main/ соответствует стандартам${NC}"
    fi

    # Laravel Pint для discogs/
    if [ -f "discogs/vendor/bin/pint" ]; then
        echo "🎨 Проверка стиля кода discogs/ (Laravel Pint)..."
        DISCOGS_FILES=$(echo $STAGED_PHP_FILES | tr ' ' '\n' | grep "^discogs/" | tr '\n' ' ')
        if [ -n "$DISCOGS_FILES" ]; then
            cd discogs && ./vendor/bin/pint $DISCOGS_FILES --test || display_error "Laravel Pint нашёл проблемы в discogs/. Запустите: cd discogs && composer fix"
            cd ..
        fi
        echo -e "${GREEN}✓ Код discogs/ соответствует стандартам${NC}"
    fi
fi

# Проверка Nuxt проекта
if [ -n "$STAGED_JS_FILES" ]; then
    echo -e "${YELLOW}📝 Найдено изменённых JS/TS/Vue файлов: $(echo $STAGED_JS_FILES | wc -w)${NC}"

    NUXT_FILES=$(echo $STAGED_JS_FILES | tr ' ' '\n' | grep "^nuxt/" | tr '\n' ' ')
    if [ -n "$NUXT_FILES" ] && [ -f "nuxt/package.json" ]; then
        echo "🔍 Проверка TypeScript компиляции..."
        cd nuxt && npm run typecheck || display_error "TypeScript ошибки в nuxt/. Исправьте ошибки типов"

        echo "🎨 Проверка ESLint..."
        npm run lint || display_error "ESLint нашёл проблемы в nuxt/. Запустите: cd nuxt && npm run fix"
        cd ..
        echo -e "${GREEN}✓ Код nuxt/ соответствует стандартам${NC}"
    fi
fi

# Проверка на случайный коммит .env
if git diff --cached --name-only | grep -E "^\.env(\.|$)"; then
    display_error ".env файлы не могут быть закоммичены!"
fi

# Проверка на отладочный код
if [ -n "$STAGED_PHP_FILES" ]; then
    echo "🔍 Проверка на отладочный код PHP..."
    for FILE in $STAGED_PHP_FILES; do
        if [ -f "$FILE" ]; then
            if grep -q "dd(\|dump(\|var_dump(\|print_r(" "$FILE"; then
                echo -e "${YELLOW}⚠️  Найден отладочный код в $FILE${NC}"
            fi
        fi
    done
fi

if [ -n "$STAGED_JS_FILES" ]; then
    echo "🔍 Проверка на отладочный код JS..."
    for FILE in $STAGED_JS_FILES; do
        if [ -f "$FILE" ]; then
            if grep -q "console\." "$FILE"; then
                echo -e "${YELLOW}⚠️  Найден console.* в $FILE${NC}"
            fi
        fi
    done
fi

echo -e "${GREEN}✅ Все проверки MUZILLA пройдены успешно!${NC}"
echo -e "${BLUE}🎵 Код готов к коммиту${NC}"